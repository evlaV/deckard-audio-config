declare name "Valve DSP";
declare description "Generic speaker and microphone tuning topology used for Valve hardware.";
declare version "0.2";

import("stdfaust.lib");
import("basics.lib");
import("compressors.lib");
import("filters.lib");
import("analyzers.lib");
import("reverbs.lib");
import("routes.lib");


// functions

peak(LP,FP,Q) = _ : fi.peak_eq(LP,FP,BP) : _
with {
    BP= FP/Q;
};

// 5 band EQ.
eq5(i, LP0, FP0, Q0, LP1, FP1, Q1, LP2, FP2, Q2, LP3, FP3, Q3, LP4, FP4, Q4) =
    _ :
    fi.peak_eq_cq(LP0, FP0, Q0) :
    fi.peak_eq_cq(LP1, FP1, Q1) :
    fi.peak_eq_cq(LP2, FP2, Q2) :
    fi.peak_eq_cq(LP3, FP3, Q3) :
    fi.peak_eq_cq(LP4, FP4, Q4) :
    _ ;

// 8 band EQ.
eq(i, LP0, FP0, Q0, LP1, FP1, Q1, LP2, FP2, Q2, LP3, FP3, Q3, LP4, FP4, Q4, LP5, FP5, Q5, LP6, FP6, Q6, LP7, FP7, Q7) =
    _ :
    fi.peak_eq_cq(LP0, FP0, Q0) :
    fi.peak_eq_cq(LP1, FP1, Q1) :
    fi.peak_eq_cq(LP2, FP2, Q2) :
    fi.peak_eq_cq(LP3, FP3, Q3) :
    fi.peak_eq_cq(LP4, FP4, Q4) :
    fi.peak_eq_cq(LP5, FP5, Q5) :
    fi.peak_eq_cq(LP6, FP6, Q6) :
    fi.peak_eq_cq(LP7, FP7, Q7) :
    _ ;


pre_comp_hp(IN_HP_FREQ) = fi.highpass(2,IN_HP_FREQ);

bass_stereo2mono(BASS_FREQ, BASS_GAIN_DB) =
     _ , _ <: _ , _ , _ , _ : fi.highpassLR4(BASS_FREQ),  fi.highpassLR4(BASS_FREQ) , fi.lowpassLR4(BASS_FREQ) * 0.5* ba.db2linear(BASS_GAIN_DB) , fi.lowpassLR4(BASS_FREQ) * 0.5 * ba.db2linear(BASS_GAIN_DB)  : _, _, +  : route(3,4,(1,1),(2,3),(3,2),(3,4)) : +, + : _ , _ ;

bass_management(IN_GAINM_DB,BASSM_FREQ,BASSM_GAIN_DB) = _*ba.db2linear(IN_GAINM_DB) , _*ba.db2linear(IN_GAINM_DB) <: _ , _ , _ , _ :
    fi.highpassLR4(BASSM_FREQ), fi.highpassLR4(BASSM_FREQ), fi.lowpassLR4(BASSM_FREQ), fi.lowpassLR4(BASSM_FREQ) :
    route(4,6,(1,1),(3,2),(4,3),(2,4),(4,5),(3,6)) :
    _,_,_*ba.db2linear(BASSM_GAIN_DB),_,_,_*ba.db2linear(BASSM_GAIN_DB) :
    + , _ , + , _ : + , + : _ , _ ;

input_compressor(IN_GAIN_DB, STRENGTH, THRESHOLD, ATTACK, RELEASE, KNEE, STEREO_LINK) =
    co.FFcompressor_N_chan(STRENGTH, THRESHOLD, ATTACK, RELEASE, KNEE, 1, STEREO_LINK, meter, 2) : _ * ba.db2linear(IN_GAIN_DB), _ * ba.db2linear(IN_GAIN_DB)
with
{
    meter = _;
};
	
denver_speaker_tuning(IN_GAIN_DB, IN_HP_FREQ, IN_COMP_STRENGTH, IN_COMP_THRESHOLD, IN_COMP_ATTACK, IN_COMP_RELEASE, IN_COMP_KNEE, IN_COMP_STEREO_LINK, BASS_FREQ, BASS_GAIN_DB) =
//  Left Channel, Right Channel:
    _, _ :
    aa.clip(-2.0, 2.0), aa.clip(-2.0, 2.0) :
    fi.dcblockerat(20.0), fi.dcblockerat(20.0) :
    pre_comp_hp(IN_HP_FREQ), pre_comp_hp(IN_HP_FREQ):
    bass_stereo2mono(BASS_FREQ, BASS_GAIN_DB) :
    input_compressor(IN_GAIN_DB, IN_COMP_STRENGTH, IN_COMP_THRESHOLD, IN_COMP_ATTACK, IN_COMP_RELEASE, IN_COMP_KNEE, IN_COMP_STEREO_LINK)     ;


boulder_speaker_tuning(IN_GAINM_DB, BASSM_FREQ, BASSM_GAIN_DB) =
//  Left Channel, Right Channel:
    _, _ :
    aa.clip(-2.0, 2.0), aa.clip(-2.0, 2.0) :
    fi.dcblockerat(20.0), fi.dcblockerat(20.0) :
    bass_management(IN_GAINM_DB, BASSM_FREQ, BASSM_GAIN_DB) : _ , _ ;


deckard_mic_tuning(IN_GAIN_DB, HP_FREQ, LP_FREQ, LP0, FP0, Q0, LP1, FP1, Q1, LP2, FP2, Q2, LP3, FP3, Q3, LP4, FP4, Q4) =
    _ : fi.highpass(2, HP_FREQ) : fi.lowpass(2,LP_FREQ) : eq5(1, LP0, FP0, Q0, LP1, FP1, Q1, LP2, FP2, Q2, LP3, FP3, Q3, LP4, FP4, Q4) :
        _ * ba.db2linear(IN_GAIN_DB) :
        _
with
{
    meter = _;
};
